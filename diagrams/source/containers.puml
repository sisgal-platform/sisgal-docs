@startuml C4_Container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person(admin, "Administrador")
Person(employee, "Empleado")

System_Boundary(system, "Sistema de Gestión") {
    Container(frontend, "Frontend Web", "React", "Interfaz de usuario; autentica mediante Supabase Auth")
    Container(backend, "Backend Core", "Node.js/NestJS", "API REST y módulos de negocio; monolito modular")
}

System_Boundary(databases, "Bases de datos") {
    ContainerDb(system_db, "Base de datos principal", "PostgreSQL (Supabase)", "Datos del sistema")
    ContainerDb(audit_db, "Base de datos de auditoría (diseño)", "PostgreSQL", "Base independiente aún no conectada")
}

System_Ext(supabase_auth, "Supabase Auth", "Servicio externo de autenticación")

Rel(admin, frontend, "Usa")
Rel(employee, frontend, "Usa")
Rel(frontend, backend, "Consume API REST", "HTTPS/JSON")
Rel(frontend, supabase_auth, "Autentica usuarios", "HTTPS")
Rel(backend, system_db, "Lee y escribe datos del sistema")

@enduml
